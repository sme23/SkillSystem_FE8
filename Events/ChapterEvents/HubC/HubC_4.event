BeginningScene:
LoadEnemies(EnemyUnits1)
LoadEnemies(EnemyUnits2)
LoadEnemies(EnemyUnits3)
LoadEnemies(EnemyUnits4)
SetBackground(Fort_2)
MUSC OrlandosThemeID
Text(C4_BS_1)
FADI 15
FadeOutMusic
CAMERA_CENTERED [8,22]
STAL 60
EraseBackground
MUSC FinInTheCloudsID
FlashCursor(8,22,30)
FlashCursor(9,22,30)
LoadPlayerUnits(CutsceneUnits)
STAL 30
TEXTSTART
TEXTSHOW C4_BS_2
TEXTEND
CameraCursor(9,14)
CAMERA_CENTERED Razvan
STAL 30
TEXTCONT
TEXTEND
REMA
FADI 15
GotoPrepScreen
NoFade
ENDA

EndingScene:
FADI 15
LOMA HubC_4_Cutscene
RemoveAll
CAMERA_CENTERED [8,22]
FadeOutMusic
STAL 60
FADU 15
CHECK_ALIVE Remora
BEQ 776 s0 sC
    LOAD1 1 PostBattleRemoraGroup
    ENUN
    LoadCutsceneUnits(EndingSceneRemoraGroup)
    CAMERA_CENTERED [8,7]
    MUSC ASoldiersDutyID
    Text(C4_ES_1)
    FlashCursor(7,11,30)
    FlashCursor(8,11,30)
    FlashCursor(9,11,30)
    TILECHANGE 0
    SOUN AttackSnagSoundID
    Text(C4_ES_2)
    CamOff
    STAL 30
    MOVE 15 Razvan [7,9]
    STAL 30
    MOVE 15 Razvan [9,9]
    STAL 30
    MOVE 15 Razvan [8,9]
    ENUN
    CamOn
    Text(C4_ES_3_1)
    MOVE 15 Lua [8,4]
    MOVE 15 Remora [8,5]
    ENUN
    FadeOutMusic
    FlashCursor(8,3,60)
    MUSC OrlandosThemeID
    Text(C4_ES_3_2)
    TILECHANGE 1
    SOUN UnlockDoorChestSoundID
    STAL 30
    GiveItem(WhiteGem, Lua)
    MOVE 15 Lua [9,9]
    MOVE 15 Remora [7,9]
    ENUN
    STAL 30
    Text(C4_ES_4)
    FadeOutMusic
    CameraCursor(8,11)
    TILEREVERT 0
    SOUN AttackSnagSoundID
    CamOff
    MOVE 15 Lua [10,17]
    MOVE 15 Razvan [6,17]
    MOVE 15 Remora [8,17]
    ENUN
    SVAL s1 0x1
    SET_CONDITION Remora //Hide
    STAL 30
    GOTO 777
LABEL 776
    LoadCutsceneUnits(EndingSceneNoRemoraGroup)
    MUSC CherishTheDeadID
    Text(C4_ES_1_NoRemora)
    FlashCursor(7,11,30)
    FlashCursor(8,11,30)
    FlashCursor(9,11,30)
    TILECHANGE 0
    SOUN AttackSnagSoundID
    Text(C4_ES_2_NoRemora)
    CamOff
    STAL 30
    MOVE 15 Razvan [7,9]
    STAL 30
    MOVE 15 Razvan [9,9]
    STAL 30
    MOVE 15 Razvan [8,9]
    ENUN
    CamOn
    Text(C4_ES_3_1_NoRemora)
    MOVE 15 Lua [8,4]
    MOVE 15 Remora [8,5]
    ENUN
    Text(C4_ES_3_2_NoRemora)
    TILECHANGE 1
    SOUN UnlockDoorChestSoundID
    STAL 30
    GiveItem(WhiteGem, Lua)
    MOVE 15 Lua [9,9]
    ENUN
    STAL 30
    Text(C4_ES_4)
    FadeOutMusic
    CameraCursor(8,11)
    TILEREVERT 0
    SOUN AttackSnagSoundID
    CamOff
    MOVE 15 Lua [10,17]
    MOVE 15 Razvan [6,17]
    ENUN
    STAL 30
LABEL 777
MOVE 10 Pilar [8,10]
MOVE 15 Desiderio [8,11]
ENUN
MUSC CastawayHeartID
TEXTSTART
TEXTSHOW C4_ES_5
TEXTEND
CAMERA_CENTERED [8,17]
STAL 60
TEXTCONT
TEXTEND
REMA
CAMERA_CENTERED [8,10]
STAL 60
CHECK_EVENTID WentToHub3
BEQ 420 s0 sC
    Text(C4_ES_6_C3Seen)
    GOTO 421
LABEL 420
Text(C4_ES_6_C3Unseen)
LABEL 421
MOVE 15 Lua [8,12]
ENUN
Text(C4_ES_7_1)
MOVE 15 Lua [8,17]
ENUN
Text(C4_ES_7_2)
MOVE 10 Desiderio [8,16]
ENUN
Text(C4_ES_8)
GoToHubChapter(HubC)
NoFade
ENDA

