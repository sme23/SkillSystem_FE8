//----------------------------------------------
//BeginningScene
//----------------------------------------------

// LOMA CutsceneHubC_3_A

BeginningScene:
//Objective progress is tracked here
COUNTER_SET 0 0
COUNTER_SET 1 0

//During this scene, the first several units in the player's party are loaded. If player has saved in preps, temporarily hide Bolton (NPC Dark Knight uses a different unit ID)
CHECK_EXISTS Bolton
IFNE 1 sC s0
	REMU Bolton
LABEL 1

WEATHER 7
LoadCutsceneUnits(IntroGroup1)
TILECHANGE 0
ClearBackground
STAL 45
LOAD1 0 IntroGroup2
LOAD3 2 IntroGroup3 //this is what Bolton is hidden for
ENUN
STAL 15
FlashCursor(Lua, 40)
FlashCursor(Boru, 40)
STAL 15
MUSC MeetTheCrewID
Text(HubC_3Intro1)
STAL 20

MOVE 5 Rima [5,4]
MOVE 6 C3Pirate [6,4]
ENUN
STAL 15
Text(HubC_3Intro2)
STAL 20

MOVE 6 Rima [0,6]
MOVE 7 C3Pirate [0,7] // 6-7 LMAO!!!!!!!
ENUN
DISA Rima
DISA C3Pirate
STAL 10
Text(HubC_3Intro3)
// Pilar moves over.
MOVE 5 Pilar [4,7]
ENUN
FlashCursor(Pilar,60)
Text(HubC_3Intro4)
FADI 10
REMA
STAL 45

TILECHANGE 1
CLEA 0
CLEN 0
CHECK_EXISTS Bolton
IFNE 2 sC s0
	REVEAL Bolton
LABEL 2

// We have a secret meeting with Salman and prospective Rebel Rebels...
LOMA CutsceneHubC_3_A
CAMERA_CENTERED [0,7]
LoadCutsceneUnits(IntroGroupFlashback1)
MUSC AKeepersOathID
FADU 6
BROWNBOX HubC_3FlashbackLocation [0,0]
STAL 60
FlashCursor(Salman, 60)
SetBackground(0x20) //within the woods at night
TEXTSTART
TEXTSHOW(HubC_3Flashback1)
TEXTEND
EraseBackground

// Salman leaves, along with a few rebels. Boru mutters to himself...
STAL 30
MOVE 5 Salman [9,1]
MOVE 5 GreagorPatron [7,1] //halb
MOVE 5 GreagorPatronB [8,1] //curate
STAL 30
MOVE 7 GreagorVillager [8,0] //griffin
MOVE 5 GreagorVillagerB [9,0] //vanguard
MOVE 6 GreagorVillagerC [7,0] //ninja
ENUN

FlashCursor(Boru, 60)
TEXTSTART
