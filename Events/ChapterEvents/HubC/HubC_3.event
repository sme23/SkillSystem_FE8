//----------------------------------------------
//Turn Events
//----------------------------------------------

TurnOnSalmanAbleRescueFlagEvent:
ENUT SalmanTriggerRescueDialogueFlag
ENDA

TurnOffSalmanAbleRescueFlagEvent:
ENUF SalmanTriggerRescueDialogueFlag

C3FirstTurnEvent:
CenterTextbox(EarlyLeaveExplanation)
STAL 20

//TESTING
	//ENUT 3
	//CALL EndingScene
	//ENDB

NoFade
ENDA

Turn4Reinforcements:
SpawnReinforcements(Turn4ReinforcementsNEGroup)
SpawnReinforcements(Turn4ReinforcementsSWGroup)
NoFade
ENDA

Turn6Reinforcements:
SpawnReinforcements(Turn6ReinforcementsSWRiverGroup)
// Stole this macro from D-3, make this Ninja aggressive!
CheckForCharAtCoordsThenCHAI(14, 30, C3Pirate, 776, 0, 0, 0, 0)
NoFade
ENDA

RimaJoins:

// If alive and undeployed, play escaped.
// If alive and deployed, play early leave. 
// If dead, play dead. 
CHECK_ALIVE Bolton
IFNE 776 sC s0
  CHECK_DEPLOYED Bolton
  IFEQ 777 sC s0
LABEL 776 //Both dead and escaped cases fall here.
//  If Bolton has already escaped, or is killed/retreated/escaped,
//  Rima enters the map through this turn event.
	CAM1 [7,20]
	STAL 10
	LoadPlayerUnits(NewUnit_Rima)
	STAL 20
  FlashCursor(Rima, 60)
  CHECK_ALIVE Bolton
  IFEQ 3 sC s0
    // Bolton dead
    Text(HubC_3RimaJoins_AfterBoltonDead)
    GOTO 2
  LABEL 3
    // Bolton escaped
    Text(HubC_3RimaJoins_AfterBoltonEscapes)
    GOTO 2
    
LABEL 777
//If Bolton is alive, Rima enters the map by being selected through Early Leave
	LoadPlayerUnits(NewUnit_RimaOffscreen)
	SetUnitStatus(Rima,State,0x00000009)
  CAMERA Bolton
  STAL 20
  FlashCursor(Bolton, 60)
  Text(HubC_3RimaJoins_BeforeBoltonEarlyLeaves)
LABEL 2
NoFade
ENDA

Turn7SalmanWakesUp:
BranchIfNotUnitAtCoords(24, 8, Salman, 776)
	CAM1 Salman
	STAL 20
	Text(HubC_3SalmanWakesUp)
	SetAI(Salman,0x6,0xC,0x4,0x0)
	GOTO 777
LABEL 776

LABEL 777
NoFade
ENDA

Turn8Reinforcements:
CAM1 [18,22]
STAL 20
LoadEnemies(Turn8ReinforcementsSEGroup)
CHECK_ALIVE Jasper
IFNE 776 sC s0
	STAL 30
	CAM1 [21, 14]
	STAL 20
	FlashCursor(Jasper, 60)
	Text(HubC_3JasperAggro)
	SetAI(Jasper,0,0,4,0)
LABEL 776
STAL 10
NoFade
ENDA

Turn9ReinforcementWarning:
