EndingScene:
//Objective progress was tracked here
COUNTER_SET 0 0
COUNTER_SET 1 0

FADI 10

//If player wins before Turn 5, Rima joins automatically
CHECK_EXISTS Rima
IFEQ 11 sC s0
	LoadPlayerUnits(NewUnit_Rima)
LABEL 11

CLEA 0
CLEE 0
CLEN 0
LoadCutsceneUnits(EndingGroup1)
MUSC FinInTheCloudsID
CAM1 [7,20]
ClearBackground
STAL 60
MOVE 0 Runamel [4,20]
ENUN

FlagIsSet(0x02, 776) // Boss was routed, Runamel immediately retreats.
	Text(HubC_3Ending2_BossDefeated)

	MOVE 0 Runamel [19,21]
	STAL 10
	MOVE 0 C3Pirate [19,20]
	MOVE 0 C3Traitor [19,22]
	ENUN
	DISA Runamel
	DISA C3Pirate
	DISA C3Traitor
	STAL 20

	LoadCutsceneUnits(EndingGroup2)
	FlashCursor(GreagorVillager, 60)
	STAL 10
	FADI 10
	SetBackground(0x1D) //wilderness, close to mountains
	MUSC StillZephyrsID
	Text(HubC_3Ending3_BossDefeated)
	REMA

	GOTO 777
LABEL 776 // Boss was not routed, Runamel threatens Lua. 
	Text(HubC_3Ending1)
	STAL 20

	LoadCutsceneUnits(EndingGroup2)
	STAL 20
	Text(HubC_3Ending2)
	STAL 20

	MOVE 0 Runamel [19,21]
	STAL 10
	MOVE 0 C3Pirate [19,20]
	MOVE 0 C3Traitor [19,22]
	ENUN
	DISA Runamel
	DISA C3Pirate
	DISA C3Traitor
	STAL 10
	FADI 10
	SetBackground(0x1D) //wilderness, close to mountains
	MUSC StillZephyrsID
	TEXTSTART
	TEXTSHOW HubC_3Ending3
	TEXTEND
	REMA

Label 777
GiveItem(BlueGem,Lua)
FADI 10
STAL 20
CHECK_ALIVE Bolton
IFNE 1 sC s0
	CHECK_ALIVE Rima
	IFNE 3 sC s0
		SetBackground(0x19) //evening wilderness, nearby forest
		MUSC WelcomeAboardMateyID
		TEXTSTART
		TEXTSHOW HubC_3EndingBothRecruits
		TEXTEND
		FADI 10
		REMA
		STAL 20
	GOTO 4
	LABEL 3
		SetBackground(0x19) //evening wilderness, nearby forest
		MUSC WelcomeAboardMateyID
		TEXTSTART
		TEXTSHOW HubC_3EndingBoltonOnly
		TEXTEND
		FADI 10
		REMA
		STAL 20
	LABEL 4
GOTO 2
LABEL 1
	CHECK_ALIVE Rima
	IFNE 5 sC s0
		SetBackground(0x19) //evening wilderness, nearby forest
		MUSC WelcomeAboardMateyID
		TEXTSTART
		TEXTSHOW HubC_3EndingRimaOnly
		TEXTEND
		FADI 10
		REMA
		STAL 20
	LABEL 5
	//No conversation if both Bolton and Rima are dead
LABEL 2

MUSCSLOW 0x7FFF
SetBackground(0x19) //evening wilderness, nearby forest
MUSC WindAmbienceID
TEXTSTART
TEXTSHOW HubC_3Ending4
TEXTEND
FADI 10
REMA
STAL 20

