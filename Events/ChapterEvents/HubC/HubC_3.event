LoadEnemies(Turn10ReinforcementsSEGroup)
FlashCursor(Runamel, 60)
IFNE 776 sC s0
	Text(HubC_3MajorBossAppearsJaspAlive)
	GOTO 777
LABEL 776
	Text(HubC_3MajorBossAppearsJaspDead)
LABEL 777
STAL 10
NoFade
ENDA

//----------------------------------------------
// AlwaysEvents
//----------------------------------------------

SalmanRescued:

CHECK_ACTIVEID Salman 
		BNE 777 0xC 0x0 //If Saman active, ignore all logic (he can't trigger his own rescue event)
BranchIfUnitAtCoords(24, 8, Salman, 777)  // salman must be off his sleeping spot 
BranchIfUnitAtCoords(23, 11, Salman, 777) // ...and also not be in the tile that he'll route to after waking up. 
											 // in theory this can be circumvented if the tile is blocked and
											 // incorrectly trigger the event anyways but I've spent too much time
											 // on this and it'd be a really crazy edge case UGH
LABEL 776	
	CHECK_TURNS //checks the turn and returns it
	SVAL s1 6 //makes s1 6, the turn Salman wakes up.
	BLT 778 s1 sC 
		//play sleeping dialogue if less than turn 6
		CHECK_ACTIVEID Pilar 
		BNE 1 0xC 0x0 //If Pilar active jump to 1
		CHECK_ACTIVEID Windy
		BNE 2 0xC 0x0 //If Windy active jump to 2
		GOTO 3
		LABEL 1
			Text(HubC_3SalmanIsRescuedAsleep_Pilar)
			GOTO 779
		LABEL 2
			Text(HubC_3SalmanIsRescuedAsleep_Windy)
			GOTO 779
		LABEL 3
			Text(HubC_3SalmanIsRescuedAsleep_Generic)
			GOTO 779
	LABEL 778
		//play normal dialogue if past turn 6
		CHECK_ACTIVEID Pilar 
		BNE 4 0xC 0x0 //If Pilar active jump to 1
		CHECK_ACTIVEID Windy
		BNE 5 0xC 0x0 //If Windy active jump to 2
		GOTO 6
		LABEL 4
			Text(HubC_3SalmanIsRescuedAwake_Pilar)
			GOTO 779
		LABEL 5
			Text(HubC_3SalmanIsRescuedAwake_Windy)
			GOTO 779
		LABEL 6
			Text(HubC_3SalmanIsRescuedAwake_Generic)
			GOTO 779
	LABEL 779
	ENUF SalmanNotRescuedFlag //event disabled
LABEL 777
NoFade
ENDA


//----------------------------------------------
//EndingScene
